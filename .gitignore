# stray workspace snapshots (can be many GB)
workspace-*-before-*/

# backup of the pre-Claude launcher
*.codex-backup

# local lab account files (live test credentials) - keep accounts.json.example only
*.accounts.json

# editor/backup copies of the launchers
*.bak

# engagement output: unfiled vulnerability reports for a live bug-bounty target.
# Never push these - publishing is a disclosure decision, not a commit.
h1-wordpress/

# per-target campaign launchers and module lists: target-specific config, not harness.
# campaigns/README.md and the example pair are the committed contract.
campaigns/*
!campaigns/README.md
!campaigns/example.sh
!campaigns/example.modules
