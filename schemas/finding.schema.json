{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "secaudit/finding.schema.json",
  "title": "Finding",
  "description": "One vulnerability finding. Written append-only as workspace/findings/<id>.json. The `status` flag + `history` are what drive the streaming convergence and the reproduction feedback loop.",
  "type": "object",
  "required": [
    "id",
    "track",
    "vuln_class",
    "status",
    "detector",
    "source",
    "sink",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable id, e.g. sha1(track + vuln_class + sink.file + sink.line). Same logical bug must hash to the same id so re-runs do not duplicate."
    },
    "correlation_id": {
      "type": "string",
      "description": "Groups findings that share a root cause (e.g. one tainted source reaching many sinks). Used by convergence for de-dup."
    },
    "track": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "F",
        "G",
        "H",
        "I",
        "J",
        "K",
        "L",
        "M",
        "N",
        "W"
      ],
      "description": "A/F/H = web data-flow, blackbox injection, or web3 fund-flow; B/G/I = web logic/authz, blackbox logic, or web3 access-control; Android tracks: M manifest/permissions, L component types/IPC, K cross-component sink chains, W WebView, N native/passive zero-click, J legacy Android Intent/deep-link."
    },
    "vuln_class": {
      "type": "string",
      "description": "e.g. sql-injection, command-injection, xss, deserialization, idor, broken-access-control, auth-bypass, business-logic."
    },
    "cwe": {
      "type": "string",
      "description": "e.g. CWE-89. Pulled from Semgrep rule metadata when available."
    },
    "title": {
      "type": "string"
    },
    "severity_estimate": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Producer's first guess. Triage may revise after reproduction."
    },
    "detector": {
      "type": "string",
      "enum": [
        "semgrep",
        "opengrep",
        "codeql",
        "llm-track-a",
        "llm-track-b",
        "llm-track-f",
        "llm-track-g",
        "llm-track-h",
        "llm-track-i",
        "llm-track-j",
        "llm-track-k",
        "llm-track-l",
        "llm-track-m",
        "llm-track-n",
        "llm-track-w"
      ],
      "description": "What produced/confirmed this finding."
    },
    "source": {
      "type": "object",
      "required": [
        "file",
        "line"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "symbol": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "What makes this attacker-controlled (e.g. GET param)."
        }
      }
    },
    "sink": {
      "type": "object",
      "required": [
        "file",
        "line"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "symbol": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "Why this is dangerous (e.g. cursor.execute)."
        }
      }
    },
    "flow": {
      "type": "array",
      "description": "Ordered source->sink path. Each hop is a step the taint/reasoning crossed.",
      "items": {
        "type": "object",
        "required": [
          "file",
          "line"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "sanitizers_seen": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Validation/escaping encountered on the path. Empty = no sanitization."
    },
    "evidence": {
      "type": "string",
      "description": "LLM reasoning for why this is (or isn't) exploitable."
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "cross_validated",
        "needs_reanalysis",
        "reproduced",
        "false_positive",
        "confirmed"
      ],
      "description": "Lifecycle. candidate -> cross_validated -> reproduced -> confirmed. Repro failure can route to false_positive OR needs_reanalysis (feedback loop)."
    },
    "repro": {
      "type": "object",
      "description": "Filled by convergence reproduction step.",
      "properties": {
        "attempted": {
          "type": "boolean"
        },
        "success": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "poc": {
          "type": "string",
          "description": "The EXACT reproducing request(s) - the full probe.py/curl command(s) incl. method, URL, headers, cookies/jar, and payload, so a human can copy-paste and re-run it. For IDOR include both identities' requests."
        },
        "observation": {
          "type": "string",
          "description": "What was observed when fired."
        },
        "env": {
          "type": "string",
          "description": "Which warm target env was used."
        },
        "response": {
          "type": "string",
          "description": "Key evidence from the live response that proves the bug (status, decisive snippet, timing, canary HIT)."
        },
        "poc_script": {
          "type": "string",
          "description": "Full, self-contained Python source of a poc.py that reproduces THIS vuln when run. Web PoCs normally use requests; Android PoCs invoke the repository's emulator-only probe harness. Saved verbatim to report/<id>/poc.py."
        }
      }
    },
    "android": {
      "type": "object",
      "description": "Android-specific reachability and reproduction context.",
      "additionalProperties": false,
      "properties": {
        "package": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "component_type": {
          "type": "string",
          "enum": [
            "activity",
            "activity-alias",
            "service",
            "receiver",
            "provider",
            "binder",
            "pending-intent",
            "webview",
            "native",
            "other"
          ]
        },
        "min_sdk": {
          "type": [
            "integer",
            "null"
          ]
        },
        "target_sdk": {
          "type": [
            "integer",
            "null"
          ]
        },
        "api_level": {
          "type": [
            "integer",
            "null"
          ]
        },
        "abi": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_digest": {
          "type": "string"
        },
        "original_sha256": {
          "type": "string"
        },
        "signature_mode": {
          "type": "string",
          "enum": [
            "original",
            "test-signed",
            "instrumented",
            "unknown"
          ]
        },
        "delivery": {
          "type": "string"
        },
        "interaction": {
          "type": "string",
          "enum": [
            "none",
            "click",
            "open-file",
            "install-local-app",
            "next-app-launch",
            "unknown"
          ]
        },
        "execution_boundary": {
          "type": "string",
          "enum": [
            "web-account",
            "javascript-bridge",
            "app-sandbox",
            "privileged-app",
            "system-app",
            "baseband",
            "kernel",
            "unknown"
          ]
        },
        "evidence_grade": {
          "type": "string",
          "enum": [
            "string-lead",
            "static-path",
            "controlled-crash",
            "sink-trace",
            "researcher-poc",
            "full-exploit",
            "in-the-wild"
          ]
        },
        "zero_click_claim": {
          "type": "string",
          "enum": [
            "not-applicable",
            "candidate",
            "probable",
            "confirmed"
          ]
        },
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "type": "string"
            },
            "data_uri": {
              "type": "string"
            },
            "flags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extras": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "caller": {
              "type": "string"
            }
          }
        },
        "instrumentation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "description": "Audit trail. Every stage that touches this finding appends an entry. Makes the feedback loop debuggable.",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "action",
          "ts"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "track-a",
              "track-b",
              "track-f",
              "track-g",
              "track-h",
              "track-i",
              "track-j",
              "track-k",
              "track-l",
              "track-m",
              "track-n",
              "track-w",
              "cross-validation",
              "reproduction",
              "triage",
              "exploitation"
            ]
          },
          "action": {
            "type": "string"
          },
          "ts": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "disclosure": {
      "type": "object",
      "description": "Set by convergence AFTER reproduction: is this already public (known CVE/advisory) or novel?",
      "properties": {
        "checked": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "novel",
            "known",
            "inconclusive"
          ],
          "description": "novel = no public report found; known = matches a published CVE/advisory; inconclusive = unsure"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "CVE ids / advisory URLs found via web search"
        },
        "rationale": {
          "type": "string",
          "description": "why classified novel/known (what the search showed)"
        }
      }
    },
    "exploit": {
      "type": "object",
      "description": "Deep exploitation result from agent D (only for critical reproduced findings)",
      "properties": {
        "depth": {
          "type": "string",
          "enum": [
            "shallow",
            "chained",
            "weaponized"
          ]
        },
        "primitive": {
          "type": "string",
          "description": "the proven base capability"
        },
        "max_impact": {
          "type": "string",
          "description": "highest verified impact reached"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mitigations_bypassed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "honest bounds, e.g. only single-token commands"
        },
        "working_poc": {
          "type": "string",
          "description": "full source of exploit.py"
        },
        "oob_evidence": {
          "type": "string"
        }
      }
    },
    "hypothesis_id": {
      "type": "string",
      "description": "id of the HYPOTHESES.json hypothesis this finding validates, if any"
    },
    "reanalysis_count": {
      "type": "integer",
      "description": "how many times this finding bounced to needs_reanalysis; capped so it isn't re-verified forever"
    }
  }
}
